{
  "$description": "Halden Ridge emissions console design tokens. Format: W3C Design Tokens (DTCG). Edit this file, then run `npm run tokens`. A token named `default` takes its group's name, so color.text.default becomes --color-text.",
  "color": {
    "$type": "color",
    "surface": {
      "bg": {
        "$value": "#0a0e11",
        "$description": "Page background and the full-screen 3D viewport."
      },
      "base": {
        "$value": "#0e1418",
        "$description": "Panels that sit on the page: design system examples, line-card strip on small screens."
      },
      "raised": {
        "$value": "#131a1f",
        "$description": "Cards and boxes that sit on a panel."
      },
      "overlay": {
        "$value": "rgba(14, 20, 24, 0.86)",
        "$description": "Floating panels over the 3D view."
      },
      "overlay-subtle": {
        "$value": "rgba(10, 14, 17, 0.72)",
        "$description": "Small chips over the 3D view: HUD, scanner status, labels."
      },
      "float": {
        "$value": "rgba(14, 20, 24, 0.9)",
        "$description": "Floating containers over the 3D view: app bar, side panel, line-card dock, overview sheet."
      },
      "scrim": {
        "$value": "rgba(6, 9, 11, 0.55)",
        "$description": "Dims the 3D view behind the overview sheet."
      }
    },
    "text": {
      "default": {
        "$value": "#ece8db",
        "$description": "Primary text."
      },
      "muted": {
        "$value": "#8b938f",
        "$description": "Labels, captions, secondary text."
      },
      "on-accent": {
        "$value": "#151004",
        "$description": "Text on solid accent fills."
      },
      "on-alarm": {
        "$value": "#1a0705",
        "$description": "Text on solid alarm fills."
      }
    },
    "border": {
      "default": {
        "$value": "#20292f",
        "$description": "Dividers and table rules."
      },
      "strong": {
        "$value": "#2d3840",
        "$description": "Panel and control outlines."
      },
      "highlight": {
        "$value": "#ffffff",
        "$description": "Hover outline for a production line, on its card and in 3D."
      }
    },
    "accent": {
      "default": {
        "$value": "#f7c948",
        "$description": "Sci-fi yellow. The one accent: active states, data, outlines in the 3D drawing."
      },
      "subtle": {
        "$value": "rgba(247, 201, 72, 0.12)",
        "$description": "Tinted backgrounds, such as copilot replies."
      },
      "border": {
        "$value": "rgba(247, 201, 72, 0.45)",
        "$description": "Accent outlines on dark controls."
      }
    },
    "status": {
      "alarm": {
        "$value": "#ff5a4e",
        "$description": "Reserved for permit-limit breaches and destructive actions."
      },
      "alarm-subtle": {
        "$value": "rgba(255, 90, 78, 0.14)",
        "$description": "Alarm backgrounds and glows."
      },
      "warning": {
        "$value": "#ff9d3d",
        "$description": "Transitional states (shutting down, starting) and kiln upsets."
      }
    },
    "chart": {
      "1": {
        "$value": "{color.accent.default}",
        "$description": "First series (Line 1)."
      },
      "2": {
        "$value": "#ff8a3d",
        "$description": "Second series (Line 2)."
      },
      "3": {
        "$value": "#9fb3c8",
        "$description": "Third series."
      },
      "4": {
        "$value": "#d9d4c4",
        "$description": "Fourth series."
      }
    },
    "emission": {
      "low": {
        "$value": "{color.accent.default}",
        "$description": "Emission scale, normal. Used by smoke and fence sensors."
      },
      "mid": {
        "$value": "#ff8a3d",
        "$description": "Emission scale, elevated."
      },
      "high": {
        "$value": "#ff4a3d",
        "$description": "Emission scale, over the limit."
      }
    },
    "scene": {
      "ground": {
        "$value": "#0c1114",
        "$description": "3D ground plane."
      },
      "fill": {
        "$value": "#0e1418",
        "$description": "Flat fill behind every 3D outline."
      },
      "fill-selected": {
        "$value": "#3a300c",
        "$description": "Fill of a selected production line."
      },
      "outline": {
        "$value": "{color.accent.default}",
        "$description": "3D outlines."
      },
      "outline-hover": {
        "$value": "{color.border.highlight}",
        "$description": "3D outline of a hovered production line."
      }
    },
    "print": {
      "header": {
        "$value": "#0e1418",
        "$description": "PDF report header band."
      },
      "header-text": {
        "$value": "#e1e1dc",
        "$description": "PDF header body text."
      },
      "accent": {
        "$value": "{color.accent.default}",
        "$description": "PDF title and section rules."
      },
      "text": {
        "$value": "#1c2024",
        "$description": "PDF body text."
      },
      "muted": {
        "$value": "#697074",
        "$description": "PDF labels and footers."
      },
      "rule": {
        "$value": "#e1e4e6",
        "$description": "PDF table rules."
      },
      "table-head": {
        "$value": "#eef0f1",
        "$description": "PDF table header fill."
      },
      "flag": {
        "$value": "#be2d23",
        "$description": "PDF values that need a regulator's attention."
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Chakra Petch",
          "Archivo",
          "Helvetica Neue",
          "sans-serif"
        ],
        "$description": "Headings, figures, labels, buttons."
      },
      "body": {
        "$value": [
          "Archivo",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Running text."
      },
      "code": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Code samples in the design system docs."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "root": {
        "$value": "14.5px",
        "$description": "Body text size."
      },
      "2xs": {
        "$value": "0.7rem",
        "$description": "Pills, badges, sub-labels."
      },
      "xs": {
        "$value": "0.77rem",
        "$description": "Captions, status chips, timestamps."
      },
      "sm": {
        "$value": "0.82rem",
        "$description": "Log rows, table cells, buttons."
      },
      "md": {
        "$value": "0.87rem",
        "$description": "Chat messages, suggestions, tabs."
      },
      "lg": {
        "$value": "0.95rem",
        "$description": "Card titles."
      },
      "xl": {
        "$value": "1.12rem",
        "$description": "Card figures, app title."
      },
      "2xl": {
        "$value": "1.35rem",
        "$description": "Floating stats, page titles."
      },
      "3xl": {
        "$value": "1.75rem",
        "$description": "KPI figures."
      }
    },
    "tracking": {
      "$type": "dimension",
      "tight": {
        "$value": "0.01em"
      },
      "normal": {
        "$value": "0.02em",
        "$description": "Display type default."
      },
      "wide": {
        "$value": "0.03em",
        "$description": "Small display labels."
      },
      "wider": {
        "$value": "0.04em",
        "$description": "The clock."
      }
    }
  },
  "shape": {
    "$type": "dimension",
    "border-width": {
      "$value": "1px"
    },
    "rule-width": {
      "$value": "2px",
      "$description": "Accent rules on the left edge of chips and messages."
    },
    "frame-corner": {
      "$value": "10px",
      "$description": "Size of the yellow corner brackets on framed panels."
    },
    "frame-stroke": {
      "$value": "2px",
      "$description": "Stroke of the corner brackets."
    },
    "chamfer": {
      "$value": "7px",
      "$description": "Cut corner on buttons."
    },
    "float-radius": {
      "$value": "2px",
      "$description": "Corner radius of floating containers. Kept near-square so the corner brackets still read."
    }
  },
  "layout": {
    "float-gap": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Gap between floating containers and the screen edge, and between each other."
    },
    "bar-height": {
      "$type": "dimension",
      "$value": "52px",
      "$description": "Height of the floating app bar."
    },
    "panel-width": {
      "$type": "dimension",
      "$value": "clamp(340px, 28vw, 440px)",
      "$description": "Width of the expanded side panel (copilot and event log)."
    },
    "panel-rail": {
      "$type": "dimension",
      "$value": "52px",
      "$description": "Width of the side panel when collapsed to a rail."
    },
    "breakpoint": {
      "$type": "dimension",
      "$value": "860px",
      "$description": "Below this width the layout stacks and containers stop floating. CSS media queries can't read variables, so console.css repeats this value."
    }
  },
  "effect": {
    "blur-overlay": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Backdrop blur behind small overlays (floating stats)."
    },
    "blur-float": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Backdrop blur behind floating containers."
    },
    "scanline-opacity": {
      "$type": "number",
      "$value": 0.022,
      "$description": "Strength of the scanline texture over the 3D view."
    },
    "vignette-opacity": {
      "$type": "number",
      "$value": 0.45,
      "$description": "Darkening at the edges of the 3D view."
    }
  },
  "elevation": {
    "$type": "shadow",
    "float": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "18px",
          "blur": "44px",
          "spread": "-12px",
          "color": "rgba(0, 0, 0, 0.75)"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.45)"
        }
      ],
      "$description": "Drop shadow for floating containers: app bar, side panel, line-card dock, overview sheet."
    },
    "raised": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "18px",
        "spread": "-6px",
        "color": "rgba(0, 0, 0, 0.6)"
      },
      "$description": "Smaller shadow for chips and stats that float over the 3D view."
    },
    "rim": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "0px",
        "spread": "0px",
        "color": "rgba(255, 255, 255, 0.04)",
        "inset": true
      },
      "$description": "Faint top highlight inside floating containers, so their edge reads against dark scenery."
    }
  },
  "scene": {
    "$type": "number",
    "grid-opacity": {
      "$value": 0.07,
      "$description": "Ground grid lines."
    },
    "dim-outline-opacity": {
      "$value": 0.4,
      "$description": "Secondary 3D outlines: stockpiles, kiln supports, fence posts."
    },
    "scanner-opacity": {
      "$value": 0.255,
      "$description": "Air scanner disc, before its radial fade."
    },
    "plume-opacity": {
      "$value": 0.6,
      "$description": "Smoke particles."
    },
    "plume-brightness": {
      "$value": 0.5,
      "$description": "Smoke colour multiplier. Particles blend additively, so lower is fainter."
    },
    "view-height": {
      "$value": 200,
      "$description": "World units visible vertically at default zoom (orthographic camera)."
    }
  },
  "motion": {
    "$type": "duration",
    "scanner-period": {
      "$value": "10s",
      "$description": "One full turn of the air scanner, and the interval of a full air pass."
    },
    "panel": {
      "$value": "240ms",
      "$description": "Side panel collapse and expand, and the 3D view re-centring with it."
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0.7,
        0.2,
        1
      ],
      "$description": "Easing for panel and container transitions."
    }
  }
}
